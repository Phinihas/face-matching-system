*.env

# Virtual environments
venv/
env/
.venv/
.env/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# FastAPI / general Python logs
*.log

# Local environment variables
.env
.env.*  # multiple env files like .env.dev, .env.prod

# IDE / Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Pytest
.cache/
.pytest_cache/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

